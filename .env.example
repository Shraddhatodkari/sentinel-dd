# Copy to .env and fill in. Never commit .env.
SENTINEL_ENV=dev
SENTINEL_LLM_PROVIDER=fake            # anthropic | openai | bedrock | vertex | fake
SENTINEL_LLM_FALLBACKS=[]             # e.g. ["bedrock","openai"]
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_ANTHROPIC_MODEL=claude-sonnet-4-5
SENTINEL_OPENAI_API_KEY=
SENTINEL_AWS_REGION=us-east-1
SENTINEL_VERTEX_PROJECT=
SENTINEL_VECTOR_BACKEND=memory        # memory | qdrant | pgvector
SENTINEL_QDRANT_URL=http://localhost:6333
SENTINEL_POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_EMBEDDING_BACKEND=hashing    # hashing | sentence_transformers | openai
SENTINEL_JWT_SECRET=replace-with-64-random-chars-from-a-secret-manager-xxxxxxxxxxxxxxx
SENTINEL_HITL_RISK_THRESHOLD=0.6
SENTINEL_MLFLOW_TRACKING_URI=
SENTINEL_DEMO_PASSWORD=sentinel-demo
