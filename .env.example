# Copy to .env and fill in. NEVER commit .env. Every setting maps to sentinel.config.Settings (prefix SENTINEL_).

# --- runtime -------------------------------------------------------------------------------------------------
# dev | test | staging | prod  (prod refuses insecure defaults at start-up)
SENTINEL_ENV=dev
SENTINEL_LOG_LEVEL=INFO
# raw-source store, LangGraph checkpoints, model registry
SENTINEL_DATA_DIR=var

# --- persistence ---------------------------------------------------------------------------------------------
SENTINEL_DATABASE_URL=sqlite:///var/sentinel.db
# prod: SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:<password>@<host>:5432/sentinel
SENTINEL_CHECKPOINT_URL=var/checkpoints.sqlite
# prod: SENTINEL_CHECKPOINT_URL=postgresql://sentinel:<password>@<host>:5432/sentinel
# used by docker-compose only
POSTGRES_PASSWORD=

# --- security ------------------------------------------------------------------------------------------------
# >= 32 random chars from a secret manager (python -c "import secrets;print(secrets.token_urlsafe(48))")
SENTINEL_JWT_SECRET=
SENTINEL_JWT_TTL_MINUTES=30
SENTINEL_RATE_LIMIT_PER_MINUTE=120
SENTINEL_LOGIN_RATE_LIMIT_PER_MINUTE=10
SENTINEL_PASSWORD_MIN_LENGTH=12

# --- external sources ----------------------------------------------------------------------------------------
# SEC fair-access policy requires a real contact
SENTINEL_SEC_USER_AGENT="YourOrg compliance-research you@yourorg.com"
SENTINEL_HTTP_TIMEOUT_S=30
SENTINEL_HTTP_MAX_RETRIES=3
SENTINEL_SOURCE_CACHE_TTL_S=21600
SENTINEL_SANCTIONS_MAX_AGE_H=36
SENTINEL_ENABLE_GDELT=true
SENTINEL_GDELT_TIMESPAN=1week
# OpenSanctions data is CC BY-NC: enable only with a commercial licence
SENTINEL_ENABLE_OPENSANCTIONS_PEPS=false

# --- LLM (optional; default "extractive" makes no external model calls) -------------------------------------
# extractive | anthropic | openai | bedrock | vertex
SENTINEL_LLM_PROVIDER=extractive
# e.g. ["bedrock"]
SENTINEL_LLM_FALLBACKS=[]
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_ANTHROPIC_MODEL=claude-sonnet-4-5
SENTINEL_OPENAI_API_KEY=
SENTINEL_AWS_REGION=us-east-1
SENTINEL_VERTEX_PROJECT=

# --- retrieval / screening / governance ----------------------------------------------------------------------
# hashing | sentence_transformers | openai
SENTINEL_EMBEDDING_BACKEND=hashing
SENTINEL_GROUNDING_THRESHOLD=0.6
SENTINEL_SCREENING_REVIEW_THRESHOLD=0.88
# false = every case receives a human decision
SENTINEL_AUTO_CLEAR_ENABLED=false
# background | inline
SENTINEL_RUNNER_MODE=background
SENTINEL_RUNNER_WORKERS=2
# SENTINEL_JURISDICTION_POLICY_PATH=/etc/sentinel/jurisdictions.json
